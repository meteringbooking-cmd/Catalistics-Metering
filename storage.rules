rules_version = '2';

// Catalistics — Cloud Storage rules.
// Portal documents: anyone signed in with an active profile can read; admins and managers upload.
service firebase.storage {
  match /b/{bucket}/o {
    function profile() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }

    match /portal-documents/{file} {
      allow read: if request.auth != null && profile().get('active', true) == true;
      allow write: if request.auth != null && profile().role in ['admin', 'manager']
                   && (request.resource == null || request.resource.size < 25 * 1024 * 1024);
    }
  }
}
